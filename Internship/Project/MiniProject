
def log_operation(function):
    def wrapper():
        print("\nOperation started...")
        function()
        print("Operation completed.")
    return wrapper


class FoodItem:
    def __init__(self, item_id, name, price):
        self.item_id = item_id
        self.name = name
        self.price = price
        self.available = True

    def get_price(self):
        return self.price

    def get_details(self):
        return self.name + " - Rs." + str(self.price)

    def __str__(self):
        return str(self.item_id) + " " + self.get_details()


class Pizza(FoodItem):
    def __init__(self, item_id, name, price, size):
        super().__init__(item_id, name, price)
        self.size = size

    def get_price(self):
        if self.size == "Large":
            return self.price + 100
        elif self.size == "Medium":
            return self.price + 50
        else:
            return self.price

    def get_details(self):
        return self.name + " " + self.size + " - Rs." + str(self.get_price())


class Burger(FoodItem):
    def __init__(self, item_id, name, price, cheese):
        super().__init__(item_id, name, price)
        self.cheese = cheese

    def get_price(self):
        if self.cheese == "Yes":
            return self.price + 30
        else:
            return self.price

    def get_details(self):
        return self.name + " - Rs." + str(self.get_price())


class Beverage(FoodItem):
    def __init__(self, item_id, name, price, size):
        super().__init__(item_id, name, price)
        self.size = size

    def get_price(self):
        if self.size == "Large":
            return self.price + 20
        else:
            return self.price

    def get_details(self):
        return self.name + " " + self.size + " - Rs." + str(self.get_price())


class FoodIterator:
    def __init__(self, food_items):
        self.food_items = food_items
        self.index = 0

    def __iter__(self):
        return self

    def __next__(self):
        if self.index < len(self.food_items):
            food = self.food_items[self.index]
            self.index = self.index + 1
            return food
        else:
            raise StopIteration


class Restaurant:
    restaurant_count = 0

    def __init__(self, restaurant_id, name):
        self.restaurant_id = restaurant_id
        self.name = name
        self.food_items = []

        Restaurant.restaurant_count = Restaurant.restaurant_count + 1

    def add_food(self, food):
        self.food_items.append(food)

    def show_food(self):
        iterator = FoodIterator(self.food_items)

        for food in iterator:
            if food.available:
                print(food)

    def __str__(self):
        return str(self.restaurant_id) + " - " + self.name


class Customer:
    customer_count = 0

    def __init__(self, customer_id, name):
        self.customer_id = customer_id
        self.name = name
        self.order = []

        Customer.customer_count = Customer.customer_count + 1

    def add_food(self, food, quantity):

        if quantity <= 0:
            raise ValueError("Quantity must be greater than 0")

        if food.available == False:
            raise Exception("Food is not available")

        self.order.append([food, quantity])

    def remove_food(self, item_id):

        for item in self.order:

            food = item[0]

            if food.item_id == item_id:
                self.order.remove(item)
                print("Food removed successfully.")
                return

        raise Exception("Food item not found in order")

    def calculate_bill(self):

        if len(self.order) == 0:
            raise Exception("Order is empty")

        total = 0

        for item in self.order:

            food = item[0]
            quantity = item[1]

            total = total + food.get_price() * quantity

        return total

    def show_order(self):

        if len(self.order) == 0:
            print("Order is empty.")
            return

        print("\nYour Order")

        for item in self.order:

            food = item[0]
            quantity = item[1]

            price = food.get_price() * quantity

            print(
                food.get_details(),
                "x",
                quantity,
                "=",
                price
            )

        print("Total Bill: Rs.", self.calculate_bill())


class Order:
    order_count = 0

    def __init__(self, customer, restaurant):

        Order.order_count = Order.order_count + 1

        self.order_id = Order.order_count
        self.customer = customer
        self.restaurant = restaurant

        self.items = []

        for item in customer.order:
            self.items.append(item)

        self.total = customer.calculate_bill()

        self.status = "Placed"

    def update_status(self, status):
        self.status = status

    def show_order_details(self):

        print("\nOrder ID:", self.order_id)
        print("Customer:", self.customer.name)
        print("Restaurant:", self.restaurant.name)

        print("\nItems:")

        for item in self.items:

            food = item[0]
            quantity = item[1]

            print(
                food.get_details(),
                "x",
                quantity
            )

        print("Total Bill: Rs.", self.total)
        print("Status:", self.status)

    def __str__(self):

        return (
            "Order ID: " + str(self.order_id)
            + " | Customer: " + self.customer.name
            + " | Restaurant: " + self.restaurant.name
            + " | Bill: Rs." + str(self.total)
            + " | Status: " + self.status
        )


def generate_order_records(orders):

    for order in orders:
        yield order


restaurants = []
customers = []
orders = []


def create_restaurants():

    restaurant1 = Restaurant(1, "Food Palace")

    restaurant1.add_food(
        Pizza(101, "Margherita Pizza", 200, "Medium")
    )

    restaurant1.add_food(
        Pizza(102, "Farmhouse Pizza", 300, "Large")
    )

    restaurant1.add_food(
        Burger(103, "Veg Burger", 120, "Yes")
    )

    restaurant1.add_food(
        Beverage(104, "Coke", 50, "Small")
    )


    restaurant2 = Restaurant(2, "Tasty Corner")

    restaurant2.add_food(
        Pizza(201, "Cheese Pizza", 250, "Medium")
    )

    restaurant2.add_food(
        Burger(202, "Chicken Burger", 180, "Yes")
    )

    restaurant2.add_food(
        Beverage(203, "Pepsi", 50, "Large")
    )


    restaurants.append(restaurant1)
    restaurants.append(restaurant2)


def find_restaurant(restaurant_id):

    for restaurant in restaurants:

        if restaurant.restaurant_id == restaurant_id:
            return restaurant

    raise Exception("Invalid restaurant ID")


def find_customer(customer_id):

    for customer in customers:

        if customer.customer_id == customer_id:
            return customer

    raise Exception("Customer not found")


def find_food_item(restaurant, item_id):

    for food in restaurant.food_items:

        if food.item_id == item_id:
            return food

    raise Exception("Invalid food item ID")


def take_customer_input():

    try:

        customer_id = int(input("Enter Customer ID: "))
        name = input("Enter Customer Name: ")

        customer = Customer(customer_id, name)

        customers.append(customer)

        print("Customer created successfully.")

    except ValueError:

        print("Invalid Customer ID")


def display_restaurants():

    print("\nRestaurants")

    for restaurant in restaurants:
        print(restaurant)


def browse_restaurants():

    try:

        display_restaurants()

        restaurant_id = int(input("Enter Restaurant ID: "))

        restaurant = find_restaurant(restaurant_id)

        print("\nFood Items in", restaurant.name)

        restaurant.show_food()

    except Exception as e:

        print("Error:", e)


def add_food_to_order():

    try:

        customer_id = int(input("Enter Customer ID: "))

        customer = find_customer(customer_id)

        display_restaurants()

        restaurant_id = int(input("Enter Restaurant ID: "))

        restaurant = find_restaurant(restaurant_id)

        print("\nFood Items")

        restaurant.show_food()

        item_id = int(input("Enter Food Item ID: "))

        food = find_food_item(restaurant, item_id)

        quantity = int(input("Enter Quantity: "))

        customer.add_food(food, quantity)

        print("Food added to order successfully.")

    except Exception as e:

        print("Error:", e)


def view_customer_order():

    try:

        customer_id = int(input("Enter Customer ID: "))

        customer = find_customer(customer_id)

        customer.show_order()

    except Exception as e:

        print("Error:", e)


def modify_customer_order():

    try:

        customer_id = int(input("Enter Customer ID: "))

        customer = find_customer(customer_id)

        if len(customer.order) == 0:
            raise Exception("Order is empty")

        customer.show_order()

        item_id = int(input("Enter Food Item ID to remove: "))

        customer.remove_food(item_id)

    except Exception as e:

        print("Error:", e)


@log_operation
def place_customer_order():

    try:

        customer_id = int(input("Enter Customer ID: "))

        customer = find_customer(customer_id)

        if len(customer.order) == 0:
            raise Exception("Order is empty")

        display_restaurants()

        restaurant_id = int(input("Enter Restaurant ID: "))

        restaurant = find_restaurant(restaurant_id)

        order = Order(customer, restaurant)

        orders.append(order)

        customer.order = []

        print("\nOrder placed successfully.")

        print("Order ID:", order.order_id)

        print("Total Bill: Rs.", order.total)

    except Exception as e:

        print("Error:", e)


def update_order_status():

    try:

        if len(orders) == 0:
            raise Exception("No orders available")

        order_id = int(input("Enter Order ID: "))

        selected_order = None

        for order in orders:

            if order.order_id == order_id:
                selected_order = order
                break

        if selected_order == None:
            raise Exception("Order not found")

        print("\nCurrent Status:", selected_order.status)

        print("1. Preparing")
        print("2. Out for Delivery")
        print("3. Delivered")

        choice = input("Enter choice: ")

        if choice == "1":

            selected_order.update_status("Preparing")

        elif choice == "2":

            selected_order.update_status("Out for Delivery")

        elif choice == "3":

            selected_order.update_status("Delivered")

        else:

            raise Exception("Invalid status choice")

        print("Order status updated successfully.")

    except Exception as e:

        print("Error:", e)


def display_all_orders():

    try:

        if len(orders) == 0:
            raise Exception("No orders found")

        generator = generate_order_records(orders)

        print("\n========== ALL ORDERS ==========")

        for order in generator:

            print(order)

    except Exception as e:

        print("Error:", e)


